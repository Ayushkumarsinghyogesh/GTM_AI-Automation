# Copy to .env and fill. NEVER commit .env
# Values with spaces must be quoted.

# --- Engine ---
ENGINE_API_KEY=change-me-long-random-string
ENGINE_URL=http://localhost:8000
GTM_REVIEWER=ayush

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL_WRITE=claude-sonnet-5-5
CLAUDE_MODEL_CLASSIFY=claude-haiku-4-5-20251001

# --- HeyReach (Settings -> Integrations -> Public API) ---
HEYREACH_API_KEY=
# HEYREACH_DEFAULT_CAMPAIGN_ID=12345
# HEYREACH_SENDER_ACCOUNT_ID=

# --- Safety rails ---
MAX_LAUNCH_PER_RUN=25

# --- n8n (docker-compose) ---
N8N_ENCRYPTION_KEY=change-me-another-random-string
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
